# Required only for live AI generation. If unset, the app falls back to
# pre-authored scenario/event/reflection content so the MVP remains playable.
OPENAI_API_KEY=

# Optional: Anthropic key (not required; OpenAI is the default provider).
ANTHROPIC_API_KEY=

# Optional: override model. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
